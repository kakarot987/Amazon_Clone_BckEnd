{
  "info": {
    "_postman_id": "f52a1d57-090b-40ec-a9e1-acd912122026",
    "name": "Amazon Clone Backend | local portfolio demo",
    "description": "Run against disposable local default Compose. Set accessToken to a signed-in demo-user JWT; never export secrets. Create returns 202 for durable outbox intent. Rerun Read aggregate until downstream consumers catch up. See docs/DEMO.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8443"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "operatorToken",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    },
    {
      "key": "operationId",
      "value": ""
    },
    {
      "key": "triageIdempotencyKey",
      "value": ""
    },
    {
      "key": "recheckIdempotencyKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 | Gateway health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/actuator/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Gateway health is available\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 | Anonymous catalog is denied",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/product-composite/1",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Anonymous access is rejected\", function () { pm.expect([401, 403]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 | Create aggregate (202 durable intent)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/product-composite",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": {{productId}},\n  \"name\": \"Portfolio Demo Mechanical Keyboard\",\n  \"weight\": 750,\n  \"sku\": \"PORTFOLIO-KEYBOARD-{{productId}}\",\n  \"description\": \"Disposable local demo product for testing composite event fan-out.\",\n  \"category\": \"electronics\",\n  \"price\": 1499,\n  \"currency\": \"INR\",\n  \"stockQuantity\": 12,\n  \"imageUrls\": [],\n  \"recommendations\": [\n    {\n      \"recommendationId\": 1,\n      \"author\": \"Demo Author\",\n      \"rate\": 5,\n      \"content\": \"Pairs well with a local portfolio setup.\"\n    }\n  ],\n  \"reviews\": [\n    {\n      \"reviewId\": 1,\n      \"author\": \"Demo Reviewer\",\n      \"subject\": \"Demo review\",\n      \"content\": \"Synthetic review, not a real customer endorsement.\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Synthetic product + recommendation + review. Clear collection variable productId between independent demo runs. No immediate read-after-write guarantee."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get(\"productId\")) { pm.collectionVariables.set(\"productId\", String(100000 + Math.floor(Math.random() * 1900000000))); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Composite creation enqueued with HTTP 202\", function () { pm.response.to.have.status(202); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 | Read aggregate (rerun until 200)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/product-composite/{{productId}}",
        "description": "Manual rerun until HTTP 200 and review/recommendation fan-out both pass. HTTP 200 on the product alone is insufficient evidence of complete aggregate delivery."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Eventual product read (rerun after 202 if not ready)\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { const p = pm.response.json(); pm.test(\"Correct product ID\", () => pm.expect(p.productId).to.eql(Number(pm.collectionVariables.get(\"productId\")))); }",
              "if (pm.response.code === 200) { const p = pm.response.json(); pm.test(\"Review and recommendation eventually visible\", () => { pm.expect(p.reviews).to.be.an(\"array\"); pm.expect(p.recommendations).to.be.an(\"array\"); pm.expect(p.reviews.some(r => r.reviewId === 1)).to.eql(true); pm.expect(p.recommendations.some(r => r.recommendationId === 1)).to.eql(true); }); }"
            ]
          }
        }
      ]
    },
    {
      "name": "05 | Search catalog",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/product-composite?query=Portfolio%20Demo&page=0&size=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Catalog query responds\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 | Inventory stock",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/product-composite/inventory/{{productId}}",
        "description": "Requires inventory:read. Available count is not a paid order or a global inventory ledger."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Inventory responds\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 | Set signed-in user's cart item",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/product-composite/cart/items/{{productId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Requires cart:write and a signed-in user JWT, not client credentials."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Cart item updated\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 | View cart",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/product-composite/cart",
        "description": "Requires cart:read and signed-in user token."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Personal cart responds\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 | Checkout (mock reservations; no charge)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/product-composite/orders",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "description": "Requires order:write, signed-in user, and cart with stock; same Idempotency-Key returns existing attempt. Payment/shipping are simulated."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get(\"idempotencyKey\")) { pm.collectionVariables.set(\"idempotencyKey\", \"portfolio-\" + Date.now()); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Order receipt returned\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { const order = pm.response.json(); if (order.orderId) pm.collectionVariables.set(\"orderId\", order.orderId); }"
            ]
          }
        }
      ]
    },
    {
      "name": "10 | Get order receipt",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/product-composite/orders/{{orderId}}",
        "description": "Requires order:read. orderId populated by successful checkout request."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Order can be read\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11 | Operator read-only inventory audit",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/product-composite/fulfillment/inventory/reconciliation",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{operatorToken}}",
              "type": "string"
            }
          ]
        },
        "description": "Optional: requires independent fulfillment:read operator token. Report is bounded and never repairs stock."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Operator audit responds\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12 | Operator aggregate reconciliation (read-only)",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{operatorToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/product-composite/fulfillment/aggregates/{{productId}}/reconciliation",
        "description": "Requires fulfillment:read; compares at most 100 outbox entries with downstream ID sets. No repair or replay."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Reconciliation request responds\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { const body = pm.response.json(); pm.test(\"Recognized diagnostic status\", () => pm.expect([\"NOT_TRACKED\", \"INCOMPLETE_HISTORY\", \"INVALID_JOURNAL\", \"PUBLISH_PENDING\", \"CONVERGING\", \"INCONCLUSIVE\", \"DRIFT_CANDIDATE\", \"OBSERVED\"]).to.include(body.status)); }"
            ]
          }
        }
      ]
    },
    {
      "name": "13 | Operator list durable operations",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{operatorToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/product-composite/fulfillment/aggregates/{{productId}}/operations?limit=10",
        "description": "Requires fulfillment:read; lists at most 10 operations touching this product, newest first. Never marks consumer success."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Operation history responds\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const rows = pm.response.json(); pm.test(\"History is a list\", () => pm.expect(rows).to.be.an(\"array\")); if (rows.length) pm.collectionVariables.set(\"operationId\", rows[0].operationId); }"
            ]
          }
        }
      ]
    },
    {
      "name": "14 | Operator inspect one durable operation",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{operatorToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/product-composite/fulfillment/operations/{{operationId}}",
        "description": "Requires fulfillment:read; requires operationId from list. BROKER_ACCEPTED never means consumer completion."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Operation inspection responds\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const body = pm.response.json(); pm.test(\"Consumer state is not overclaimed\", () => pm.expect(body.consumerStatus).to.eql(\"NOT_VERIFIED\")); }"
            ]
          }
        }
      ]
    },
    {
      "name": "15 | Operator verify signed consumer receipts (read-only)",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{operatorToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/product-composite/fulfillment/operations/{{operationId}}/receipts",
        "description": "Requires fulfillment:read. Signed internal reads compare durable consumer inbox fingerprints; missing evidence is not automatic saga failure. Secret must be configured in services."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Signed receipt audit responds\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const data = pm.response.json(); pm.test(\"Known read-only evidence state\", () => pm.expect([\"INCOMPLETE_JOURNAL\",\"CONFLICT\",\"INCONCLUSIVE\",\"RECEIPTS_MISSING\",\"PUBLISH_PENDING\",\"ALL_RECEIPTS_VERIFIED\"]).to.include(data.status)); }"
            ]
          }
        }
      ]
    },
    {
      "name": "16 | Operator inspect fenced saga supervision (read-only)",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{operatorToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/product-composite/fulfillment/operations/{{operationId}}/supervision",
        "description": "Requires fulfillment:read. Every new operation has a PENDING supervision record. Background worker is disabled unless APP_SAGA_ENABLED=true. No compensation or replay."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Supervision record responds\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const data = pm.response.json(); pm.test(\"Conservative supervision state\", () => pm.expect([\"PENDING\",\"CHECKING\",\"WAITING\",\"RECEIPTS_VERIFIED\",\"NEEDS_REVIEW\"]).to.include(data.state)); }"
            ]
          }
        }
      ]
    },
    {
      "name": "17 | Operator review queue",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{operatorToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/product-composite/fulfillment/supervisions/review-queue?limit=20",
        "description": "fulfillment:read only. Bounded NEEDS_REVIEW cases; no repair."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Review queue responds\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "18 | Operator append investigation note (only NEEDS_REVIEW)",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{operatorToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/product-composite/fulfillment/operations/{{operationId}}/triage",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{triageIdempotencyKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"INVESTIGATING\",\n  \"note\": \"Checking outbox state and transactional consumer receipt evidence.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Requires fulfillment:write operator token and a supervised NEEDS_REVIEW operation. Set triageIdempotencyKey to a fresh 8+ character key; identical repeats return original note. Other state returns 409. No compensation or replay."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Note stored or request rejected for ineligible state\",()=>pm.expect([200,409]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "19 | Operator list investigation notes",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{operatorToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/product-composite/fulfillment/operations/{{operationId}}/triage?limit=20",
        "description": "Requires fulfillment:read. Retrieves immutable investigation notes without changing saga state."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Triage notes respond\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "20 | Operator recovery overview",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{operatorToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/product-composite/fulfillment/recovery/overview",
        "description": "fulfillment:read. Bounded supervision counters and oldest undelivered outbox head; no payloads/lease tokens, no writes."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Recovery overview responds\",()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200){const p=pm.response.json();pm.test(\"Review count is nonnegative\",()=>pm.expect(p.needsReview).to.be.at.least(0));}"
            ]
          }
        }
      ]
    },
    {
      "name": "21 | Operator manual receipt recheck (NEEDS_REVIEW only)",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{operatorToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/product-composite/fulfillment/operations/{{operationId}}/rechecks",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{recheckIdempotencyKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"CONSUMER_RESTORED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Requires fulfillment:write. Set fresh 8+ char recheckIdempotencyKey. Only NEEDS_REVIEW, max 3 distinct requests. Requeues receipt inspection metadata only; DOES NOT replay business events."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Recheck accepted or rejected safely\",()=>pm.expect([200,409]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "22 | Operator read recheck request history",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{operatorToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/product-composite/fulfillment/operations/{{operationId}}/rechecks?limit=10",
        "description": "Requires fulfillment:read. Shows immutable metadata-only manual recheck requests."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Recheck history responds\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
