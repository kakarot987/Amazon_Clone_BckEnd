# Copy this file to .env and replace every example value with a unique local secret.
# Do not commit .env. Passwords for Eureka and MySQL also require matching
# configuration in the separate config-repo used by Spring Cloud Config.
CONFIG_SERVER_USR=config-user
CONFIG_SERVER_PWD=replace-with-unique-config-server-password
CONFIG_GIT_URI=https://github.com/kakarot987/config-repo.git
# Only set these when using a private configuration repository:
CONFIG_GIT_USERNAME=
CONFIG_GIT_TOKEN=
RABBITMQ_USER=app
RABBITMQ_PASSWORD=replace-with-a-unique-rabbitmq-password
EUREKA_USER=eureka-user
EUREKA_PASSWORD=replace-with-a-unique-eureka-password
MYSQL_ROOT_PASSWORD=replace-with-unique-mysql-root-password
MYSQL_PASSWORD=replace-with-unique-mysql-user-password
AUTH_WRITER_CLIENT_SECRET=replace-with-unique-writer-secret
AUTH_READER_CLIENT_SECRET=replace-with-unique-reader-secret
AUTH_DEMO_USER=demo
AUTH_DEMO_PASSWORD=replace-with-unique-demo-password

# Mock-only HMAC webhook secret; at least 32 random characters. Never reuse for real payments.
MOCK_PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# Dedicated simulator service identity, NOT a customer credential.
AUTH_FULFILLMENT_CLIENT_SECRET=replace-with-unique-mock-fulfillment-client-secret

# Dedicated mock returns operator; not for customer JWTs.
AUTH_RETURNS_CLIENT_SECRET=replace-with-unique-mock-returns-client-secret

# Dedicated simulated review moderation operator; do not grant to customers.
AUTH_MODERATOR_CLIENT_SECRET=replace-with-unique-review-moderator-client-secret

# Local-only Grafana dashboard credentials (set strong unique values).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-dashboard-password
